};

let currentIsland = null;
let currentQIndex = 0;
let answered = false;

// SES EFEKTLERİ (Web Audio API - Harici dosya gerektirmez)
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  
  if (type === 'correct') {
    osc.type = 'sine';
    osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
    osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1); // E5
    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
    osc.start(); osc.stop(audioCtx.currentTime + 0.3);
  } else if (type === 'wrong') {
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(180, audioCtx.currentTime);
    osc.frequency.linearRampToValueAtTime(120, audioCtx.currentTime + 0.3);
    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
    osc.start(); osc.stop(audioCtx.currentTime + 0.3);
  } else if (type === 'buy') {
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(800, audioCtx.currentTime);
    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
    osc.start(); osc.stop(audioCtx.currentTime + 0.15);
  }
}

function saveState() {
  localStorage.setItem('sinif6_rpg_save', JSON.stringify(state));
  updateHeader();
}

function updateHeader() {
  document.getElementById('hp-val').innerText = state.hp;
  document.getElementById('gold-val').innerText = state.gold;
  document.getElementById('lvl-val').innerText = state.level;
  const xpNeeded = state.level * 100;
  const pct = Math.min(100, (state.xp / xpNeeded) * 100);
  document.getElementById('xp-bar').style.width = pct + '%';
}

function renderMap() {
  const container = document.getElementById('islands-container');
  container.innerHTML = '';
  GAME_DATA.forEach(island => {
    const solved = state.progress[island.id] || 0;
    const total = island.questions.length;
    const isDone = solved >= total;
    const pct = (solved / total) * 100;

    const card = document.createElement('div');
    card.className = `island-card ${isDone ? 'completed' : ''}`;
    card.onclick = () => startIsland(island.id);
    card.innerHTML = `
      <div class="island-icon">${island.icon}</div>
      <div class="island-title">${island.title}</div>
      <div class="island-desc">${island.desc}</div>
      <div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div>
      <div class="island-status">${isDone ? '✅ Fethedildi! (Tekrar Oyna)' : `${solved} / ${total} Soru Tamamlandı`}</div>
    `;
    container.appendChild(card);
  });
}

function showScreen(id) {
  ['map-screen', 'quiz-screen', 'shop-screen', 'gameover-screen'].forEach(s => {
    document.getElementById(s).style.display = (s === id) ? 'block' : 'none';
  });
}

function showMap() {
  renderMap();
  showScreen('map-screen');
}

function openShop() {
  showScreen('shop-screen');
}

function buyItem(type, cost) {
  if (state.gold < cost) {
    alert("Yeterli altının yok! Adalardan soru çözerek altın kazanabilirsin.");
    return;
  }
  state.gold -= cost;
  if (type === 'hp') state.hp += 1;
  if (type === 'j50') state.j50 += 1;
  if (type === 'hint') state.hint += 1;
  playSound('buy');
  saveState();
}

function startIsland(islandId) {
  if (state.hp <= 0) {
    showScreen('gameover-screen');
    return;
  }
  currentIsland = GAME_DATA.find(i => i.id === islandId);
  const savedIdx = state.progress[islandId] || 0;
  currentQIndex = savedIdx >= currentIsland.questions.length ? 0 : savedIdx;
  showScreen('quiz-screen');
  loadQuestion();
}

function loadQuestion() {
  answered = false;
  const qObj = currentIsland.questions[currentQIndex];
  document.getElementById('quiz-subject').innerText = `${currentIsland.icon} ${currentIsland.title}`;
  document.getElementById('quiz-progress').innerText = `Soru ${currentQIndex + 1} / ${currentIsland.questions.length}`;
  document.getElementById('question-text').innerText = qObj.q;
  
  const fb = document.getElementById('feedback-box');
  fb.style.display = 'none';
  document.getElementById('next-btn').style.display = 'none';

  document.getElementById('count-50').innerText = state.j50;
  document.getElementById('count-hint').innerText = state.hint;
  document.getElementById('joker-50').disabled = state.j50 <= 0;
  document.getElementById('joker-hint').disabled = state.hint <= 0;

  const optContainer = document.getElementById('options-container');
  optContainer.innerHTML = '';
  const letters = ['A', 'B', 'C', 'D'];
  qObj.opts.forEach((optText, idx) => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    btn.innerHTML = `<strong>${letters[idx]})</strong> <span>${optText}</span>`;
    btn.onclick = () => checkAnswer(idx, btn);
    optContainer.appendChild(btn);
  });
}

function checkAnswer(selectedIdx, btnElement) {
  if (answered) return;
  answered = true;
  const qObj = currentIsland.questions[currentQIndex];
  const allBtns = document.querySelectorAll('.option-btn');
  allBtns.forEach(b => b.disabled = true);
  document.getElementById('joker-50').disabled = true;
  document.getElementById('joker-hint').disabled = true;

  const fb = document.getElementById('feedback-box');
  fb.style.display = 'block';

  if (selectedIdx === qObj.a) {
    btnElement.classList.add('correct');
    playSound('correct');
    state.gold += 15;
    state.xp += 35;
    if (state.xp >= state.level * 100) {
      state.xp -= state.level * 100;
      state.level += 1;
      state.hp += 1;
      fb.innerHTML = `🎉 Tebrikler! Doğru cevap (+15 🪙, +35 XP) ve SEVİYE ATLADIN! (+1 ❤️)`;
    } else {
      fb.innerHTML = `✅ Harika! Doğru cevap. (+15 🪙 ve +35 XP kazandın)`;
    }
    fb.style.background = 'rgba(16, 185, 129, 0.2)';
    fb.style.color = '#6ee7b7';

    // İlerlemeyi kaydet
    const prevSolved = state.progress[currentIsland.id] || 0;
    if (currentQIndex + 1 > prevSolved) {
      state.progress[currentIsland.id] = currentQIndex + 1;
    }
  } else {
    btnElement.classList.add('wrong');
    allBtns[qObj.a].classList.add('correct');
    playSound('wrong');
    state.hp -= 1;
    fb.innerHTML = `❌ Yanlış cevap! 1 Can kaybettin. Doğru şık işaretlendi.`;
    fb.style.background = 'rgba(239, 68, 68, 0.2)';
    fb.style.color = '#fca5a5';
  }

  saveState();

  if (state.hp <= 0) {
    setTimeout(() => showScreen('gameover-screen'), 1500);
  } else {
    const nextBtn = document.getElementById('next-btn');
    nextBtn.style.display = 'block';
    nextBtn.innerText = (currentQIndex + 1 < currentIsland.questions.length) ? 'Sonraki Soru →' : 'Adayı Tamamla ve Haritaya Dön 🏆';
  }
}

function nextQuestion() {
  currentQIndex++;
  if (currentQIndex < currentIsland.questions.length) {
    loadQuestion();
  } else {
    showMap();
  }
}

function useFiftyFifty() {
  if (state.j50 <= 0 || answered) return;
  const qObj = currentIsland.questions[currentQIndex];
  const allBtns = Array.from(document.querySelectorAll('.option-btn'));
  let wrongIndices = [0, 1, 2, 3].filter(i => i !== qObj.a);
  wrongIndices.sort(() => Math.random() - 0.5);
  
  allBtns[wrongIndices[0]].style.visibility = 'hidden';
  allBtns[wrongIndices[1]].style.visibility = 'hidden';
  
  state.j50 -= 1;
  document.getElementById('count-50').innerText = state.j50;
  document.getElementById('joker-50').disabled = true;
  saveState();
}

function useHint() {
  if (state.hint <= 0 || answered) return;
  const qObj = currentIsland.questions[currentQIndex];
  const fb = document.getElementById('feedback-box');
  fb.style.display = 'block';
  fb.style.background = 'rgba(245, 158, 11, 0.2)';
  fb.style.color = '#fcd34d';
  fb.innerHTML = `💡 <strong>Bilge İpucu:</strong> ${qObj.hint}`;
  
  state.hint -= 1;
  document.getElementById('count-hint').innerText = state.hint;
  document.getElementById('joker-hint').disabled = true;
  saveState();
}

function revivePlayer() {
  state.hp = 3;
  saveState();
  showMap();
}

function resetGame() {
  if (confirm("Tüm ilerlemen, altınların ve seviyen sıfırlanacak. Emin misin?")) {
    localStorage.removeItem('sinif6_rpg_save');
    location.reload();
  }
}

// Başlat
updateHeader();
showMap();
</script>
