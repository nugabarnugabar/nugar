<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>6. Sınıf Bilgi Adası Macerası (RPG)</title>
<style>
  :root {
    --bg: #0f172a;
    --card: #1e293b;
    --card-hover: #334155;
    --primary: #3b82f6;
    --accent: #f59e0b;
    --success: #10b981;
    --danger: #ef4444;
    --text: #f8fafc;
    --muted: #94a3b8;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  body { background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
  
  /* Üst Bilgi Çubuğu */
  header {
    width: 100%; max-width: 1000px; background: var(--card); padding: 15px 25px;
    border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.4); border-bottom: 2px solid #334155;
  }
  .logo { font-size: 1.4rem; font-weight: 800; color: var(--accent); display: flex; align-items: center; gap: 8px; }
  .stats { display: flex; gap: 15px; flex-wrap: wrap; }
  .stat-badge {
    background: #0f172a; padding: 8px 14px; border-radius: 12px; font-weight: 700;
    display: flex; align-items: center; gap: 6px; border: 1px solid #334155; font-size: 0.95rem;
  }
  .xp-bar-wrap { width: 100px; height: 10px; background: #334155; border-radius: 5px; overflow: hidden; }
  .xp-bar { height: 100%; background: var(--success); width: 0%; transition: width 0.4s; }

  /* Ana Konteyner */
  main { width: 100%; max-width: 1000px; padding: 25px; flex: 1; }

  /* Harita Görünümü */
  .map-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .shop-btn {
    background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none;
    padding: 10px 20px; border-radius: 12px; font-weight: 700; cursor: pointer;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3); transition: transform 0.2s;
  }
  .shop-btn:hover { transform: scale(1.05); }

  .islands-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;
  }
  .island-card {
    background: var(--card); border-radius: 18px; padding: 20px; border: 2px solid #334155;
    transition: all 0.25s; cursor: pointer; position: relative; overflow: hidden;
  }
  .island-card:hover { transform: translateY(-5px); border-color: var(--primary); background: var(--card-hover); }
  .island-card.completed { border-color: var(--success); }
  .island-icon { font-size: 2.8rem; margin-bottom: 10px; }
  .island-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 5px; }
  .island-desc { font-size: 0.9rem; color: var(--muted); margin-bottom: 15px; }
  .progress-track { width: 100%; height: 8px; background: #0f172a; border-radius: 4px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--primary); transition: width 0.3s; }
  .island-card.completed .progress-fill { background: var(--success); }
  .island-status { margin-top: 8px; font-size: 0.85rem; font-weight: 600; text-align: right; color: var(--accent); }

  /* Soru Ekranı */
  #quiz-screen, #shop-screen, #gameover-screen { display: none; }
  .quiz-box {
    background: var(--card); border-radius: 20px; padding: 30px; border: 2px solid #334155;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4);
  }
  .quiz-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; color: var(--muted); font-weight: 600; }
  .question-text { font-size: 1.3rem; font-weight: 700; line-height: 1.5; margin-bottom: 25px; }
  .options-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .option-btn {
    background: #0f172a; color: var(--text); border: 2px solid #334155; padding: 16px 20px;
    border-radius: 14px; text-align: left; font-size: 1.05rem; cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; gap: 12px;
  }
  .option-btn:hover:not(:disabled) { border-color: var(--primary); background: #1e293b; }
  .option-btn.correct { background: rgba(16, 185, 129, 0.2); border-color: var(--success); color: #6ee7b7; }
  .option-btn.wrong { background: rgba(239, 68, 68, 0.2); border-color: var(--danger); color: #fca5a5; }
  .option-btn:disabled { cursor: not-allowed; opacity: 0.7; }

  .jokers-bar { display: flex; gap: 12px; margin-top: 25px; flex-wrap: wrap; }
  .joker-btn {
    background: #334155; color: #fff; border: none; padding: 10px 16px; border-radius: 10px;
    cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 6px; transition: 0.2s;
  }
  .joker-btn:hover:not(:disabled) { background: var(--primary); }
  .joker-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .feedback-box {
    margin-top: 20px; padding: 15px; border-radius: 12px; display: none; font-weight: 600;
  }
  .next-btn {
    margin-top: 20px; background: var(--primary); color: #fff; border: none; padding: 14px 28px;
    border-radius: 12px; font-size: 1.05rem; font-weight: 700; cursor: pointer; display: none; width: 100%;
  }

  /* Dükkan */
  .shop-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 20px; }
  .shop-item {
    background: var(--card); padding: 20px; border-radius: 16px; border: 2px solid #334155;
    text-align: center; display: flex; flex-direction: column; justify-content: space-between;
  }
  .buy-btn {
    margin-top: 15px; background: var(--success); color: #fff; border: none; padding: 10px;
    border-radius: 10px; font-weight: 700; cursor: pointer;
  }
  .buy-btn:disabled { background: #475569; cursor: not-allowed; }

  .back-btn {
    background: #334155; color: #fff; border: none; padding: 8px 16px; border-radius: 10px;
    cursor: pointer; font-weight: 600; margin-bottom: 15px;
  }
  .reset-link { color: var(--muted); font-size: 0.85rem; text-decoration: underline; cursor: pointer; margin-top: 30px; display: inline-block; }
</style>
</head>
<body>

<header>
  <div class="logo">🏰 6. Sınıf Bilgi Adası</div>
  <div class="stats">
    <div class="stat-badge">❤️ <span id="hp-val">5</span></div>
    <div class="stat-badge">🪙 <span id="gold-val">50</span></div>
    <div class="stat-badge">⭐ Sv. <span id="lvl-val">1</span>
      <div class="xp-bar-wrap"><div class="xp-bar" id="xp-bar"></div></div>
    </div>
  </div>
</header>

<main>
  <!-- HARİTA EKRANI -->
  <div id="map-screen">
    <div class="map-header">
      <div>
        <h2>Keşfedilecek Ders Adaları</h2>
        <p style="color:var(--muted); font-size:0.9rem;">Tüm adaları fethet ve 6. Sınıf Ustası ol!</p>
      </div>
      <button class="shop-btn" onclick="openShop()">🛒 Bilgi Dükkânı</button>
    </div>
    <div class="islands-grid" id="islands-container"></div>
    <center><span class="reset-link" onclick="resetGame()">İlerlemeyi Sıfırla</span></center>
  </div>

  <!-- SINAV / SAVAŞ EKRANI -->
  <div id="quiz-screen">
    <button class="back-btn" onclick="showMap()">← Haritaya Dön</button>
    <div class="quiz-box">
      <div class="quiz-top">
        <span id="quiz-subject">Ders Adı</span>
        <span id="quiz-progress">Soru 1 / 6</span>
      </div>
      <div class="question-text" id="question-text">Soru metni buraya gelecek...</div>
      <div class="options-grid" id="options-container"></div>
      
      <div class="jokers-bar">
        <button class="joker-btn" id="joker-50" onclick="useFiftyFifty()">⚡ %50 Ele (<span id="count-50">2</span>)</button>
        <button class="joker-btn" id="joker-hint" onclick="useHint()">💡 Bilge İpucu (<span id="count-hint">2</span>)</button>
      </div>

      <div class="feedback-box" id="feedback-box"></div>
      <button class="next-btn" id="next-btn" onclick="nextQuestion()">Sonraki Soru →</button>
    </div>
  </div>

  <!-- DÜKKÂN EKRANI -->
  <div id="shop-screen">
    <button class="back-btn" onclick="showMap()">← Haritaya Dön</button>
    <h2>🛒 Bilgi Dükkânı</h2>
    <p style="color:var(--muted);">Kazandığın altınlarla can ve joker satın alabilirsin.</p>
    <div class="shop-grid">
      <div class="shop-item">
        <div style="font-size:2.5rem;">❤️</div>
        <h3>+1 Can Yenile</h3>
        <p style="color:var(--muted); font-size:0.9rem;">Canın azaldığında maceraya devam et.</p>
        <button class="buy-btn" onclick="buyItem('hp', 30)">30 🪙 Satın Al</button>
      </div>
      <div class="shop-item">
        <div style="font-size:2.5rem;">⚡</div>
        <h3>+1 %50 Ele Jokeri</h3>
        <p style="color:var(--muted); font-size:0.9rem;">İki yanlış şıkkı otomatik eler.</p>
        <button class="buy-btn" onclick="buyItem('j50', 25)">25 🪙 Satın Al</button>
      </div>
      <div class="shop-item">
        <div style="font-size:2.5rem;">💡</div>
        <h3>+1 Bilge İpucu</h3>
        <p style="color:var(--muted); font-size:0.9rem;">Soruyla ilgili kilit bir ipucu verir.</p>
        <button class="buy-btn" onclick="buyItem('hint', 20)">20 🪙 Satın Al</button>
      </div>
    </div>
  </div>

  <!-- CAN BİTTİ EKRANI -->
  <div id="gameover-screen" style="text-align:center; padding:50px 20px;">
    <div style="font-size:4rem;">💔</div>
    <h2 style="margin:15px 0;">Canların Tükendi!</h2>
    <p style="color:var(--muted); margin-bottom:25px;">Endişelenme, dinlenip 3 canla maceraya geri dönebilirsin.</p>
    <button class="shop-btn" onclick="revivePlayer()">🔄 3 Can ile Yeniden Başla</button>
  </div>
</main>

